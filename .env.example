# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# TELEGRAM_BOT_TOKEN: Token for Telegram bot alerts (optional, can be configured in UI)
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Target Telegram channel/group chat ID for SMC alerts
TELEGRAM_CHAT_ID=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GATEIO_API_KEY: Optional API Key for Gate.io (https://www.gate.com/ar/gate-api)
GATEIO_API_KEY=

# GATEIO_API_SECRET: Optional API Secret for Gate.io private trading operations
GATEIO_API_SECRET=
